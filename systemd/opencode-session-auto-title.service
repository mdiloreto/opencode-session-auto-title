[Unit]
Description=Backfill default OpenCode session titles
Documentation=https://github.com/mdiloreto/opencode-session-auto-title

[Service]
Type=oneshot
TimeoutStartSec=0
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=AUTOTITLE_USE_AGY=1
Environment=AUTOTITLE_MODEL=openai/gpt-5.3-codex-spark
Environment=AUTOTITLE_AGY_MODEL=gemini-3.8-flash-low
Environment=AGY_BIN=%h/.local/bin/agy
Environment=OPENCODE_BIN=%h/.local/bin/opencode
ExecStart=/usr/bin/flock -n %t/opencode-session-auto-title.lock /usr/bin/node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON %h/.config/opencode/scripts/batch-rename-sessions.ts --limit 20 --quiet
NoNewPrivileges=true
